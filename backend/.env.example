# ============================================
# Leadhub 后端环境变量样例
# ============================================
# 复制为 .env 后修改；所有可配置项都在 app/core/config.py 中定义
# init.py 生成 .env 时 SECRET_KEY 等会自动用随机值替换，下面保留占位符方便阅读

# ============================================
# 默认 PostgreSQL：make start 优先复用本机已运行的，缺的用 Docker 起
# 想要零配置单文件体验：改 DB_TYPE=sqlite（免装一切中间件）
# ============================================

# ---------- 应用基础 ----------
APP_NAME=Leadhub
APP_ENV=dev                       # dev / test / prod
DEBUG=false                       # dev 才开 true,prod 必须 false
API_V1_PREFIX=/api/v1

# ---------- 安全 ----------
# 生产环境必须使用：openssl rand -hex 32
SECRET_KEY=__SECRET_KEY__   # init.py 替换为 64 hex(必填)
JWT_ALGORITHM=HS256
# 短期 token：60 分钟。配合 /auth/refresh 换长期 refresh（cookie）
JWT_EXPIRE_MINUTES=60

# ---------- 服务监听 ----------
# 改端口让多个项目并存（8000/3000 被占时改这里；make dev/start 自动读取）
HOST=0.0.0.0
PORT=8000
# 前端 dev 端口（make dev / frontend-dev 读取）
FRONTEND_PORT=3000
WORKERS=1

# ---------- 数据库 ----------
# DB_TYPE: postgresql（默认）| sqlite（单文件零配置，存 backend/data/app.db）
DB_TYPE=postgresql
SQLITE_PATH=data/app.db

# PostgreSQL 配置（DB_TYPE=postgresql 时才生效）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=youzi-leadhub
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=youzi-leadhub

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 防止长连接被 PG / NAT 静默断开（SQLite 无效但不报错）
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600


# ---------- CORS ----------
# 生产环境必须显式列出可信域名（逗号分隔），留空 = 拒绝所有跨域
# 局域网协作（同事用你的 IP 访问）：把下面注释打开并换成你的 IP（ifconfig 查）
# CORS_ORIGINS=["http://localhost:3000","http://192.168.1.100:3000"]
# TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","192.168.1.100"]
CORS_ORIGINS=["http://localhost:3000"]
# 生产环境必须配置为真实域名
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]   # ⚠️ 生产必须加你的真实域名,否则 nginx 部署直接 400 "Invalid host header"

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text / json（生产建议 json 进 ELK）

# ---------- 初始化 ----------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_RANDOM_PASSWORD
INITIAL_ADMIN_EMAIL=admin@example.com

# ---------- 数据库自动维护 ----------
# AUTO_INIT_DB: true = 首次启动 create_all + 后续 alembic upgrade
# AUTO_SEED_DATA: true = 创建默认 admin + 3 个 demo 用户（manager/alice/bob，密码 Demo@123）
# 生产环境必须设为 false（避免 Demo@123 进入生产 DB）
AUTO_INIT_DB=true
AUTO_SEED_DATA=true               # 生产必设 false（避免 Demo@123 等公开凭据进入生产 DB）

# ---------- 线索采集 ----------
GOOGLE_MAPS_API_KEY=         # google_maps 采集器必填（Google Places API v1）
COLLECT_MAX_CONCURRENT=2     # 同时运行的采集任务数（满则排队）
COLLECT_TASK_TIMEOUT=3600    # 单任务超时（秒）
ENRICH_CONCURRENCY=5         # 富化并发站点数
SCHEDULER_ENABLED=false      # 定时调度总开关（多 worker 只在一个进程开 true）
#SCORING_WEIGHTS={"whatsapp_plugin": 50}   # 评分权重覆盖（JSON，键名见评分表）
#TARGET_REGIONS=MY,SG,ID,TH,PH,VN,AE,SA,QA,KW,BR,MX,CO,AR,CL
