# youzi LeadHub 环境变量示例
# 复制为 .env 或直接 export；全部可省略，有默认值。

# SQLite 数据库路径（默认 data/leads.db）
#BSP_DB=data/leads.db

# 出海代理。优先级：BSP_PROXY 显式指定（设为空串 = 强制直连）
#           > 自动探测本机 127.0.0.1:7890 > 直连
#BSP_PROXY=http://127.0.0.1:7890

# Scrapy 爬取节流覆盖（正常由爬取任务自动注入，仅排障时手动设置）
#YOUZI_DOWNLOAD_DELAY=0.5
#YOUZI_AUTOTHROTTLE_TARGET_CONCURRENCY=8.0
